NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# قاعدة البيانات (sqlite افتراضيًا، غيّرها إلى mysql عند النشر)
DATABASE_DRIVER=sqlite
DATABASE_URL=./drizzle/clinic.db

# المصادقة
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OAuth (اختياري)
OAUTH_ENABLED=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# تخزين الملفات (اختياري)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
