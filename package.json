{
  "name": "clinic-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/_core/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
        "build:client": "vite build --config client/vite.config.ts && esbuild server/_core/index.ts --bundle --platform=node --outfile=dist/server.js --format=esm --packages=external",
    "build:server": "esbuild server/_core/index.ts --bundle --platform=node --outfile=dist/server.js --format=esm --packages=external",
    "build": "npm run build:client && npm run build:server",
        "start": "tsx drizzle/migrate.ts && tsx drizzle/seed.ts && node dist/server.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx drizzle/migrate.ts",
    "db:seed": "tsx drizzle/seed.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@tanstack/react-query": "^5.51.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.33.0",
    "better-sqlite3": "^11.1.2",
    "mysql2": "^3.11.0",
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0",
    "lucide-react": "^0.417.0",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "framer-motion": "^11.3.19",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/better-sqlite3": "^7.6.11",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vite": "^5.3.5",
    "vitest": "^2.0.5",
    "drizzle-kit": "^0.24.0",
    "tailwindcss": "^3.4.7",
    "postcss": "^8.4.40",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "esbuild": "^0.23.0"
  }
}
